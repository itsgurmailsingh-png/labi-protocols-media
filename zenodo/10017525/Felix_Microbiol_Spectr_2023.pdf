      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Identification by High-Throughput Real-Time PCR of 30 Major Circulating Listeria monocytogenes Clonal Complexes in Europe</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:identifier>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">10.1128/spectrum.03954-22</rdf:li>
